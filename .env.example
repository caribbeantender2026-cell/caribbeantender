# Copy to .env.staging.local (gitignored) and fill in. Never commit real values.
# Everything here is for the STAGING project. Production values never go in this repo.

STAGING_PROJECT_REF=
STAGING_SUPABASE_URL=https://<project-ref>.supabase.co
STAGING_SUPABASE_PUBLISHABLE_KEY=

# Secret (service role) key. Used only by local test scripts to create confirmed test users
# and fixtures without changing staging's auth settings. Never used in browser code.
STAGING_SUPABASE_SECRET_KEY=

# Database password. Lets "supabase db push" apply migrations to staging and record their history.
STAGING_DB_PASSWORD=

# Personal access token, only needed if staging is in a different Supabase account than the CLI login,
# and to read auth settings through the Management API for the staging/production comparison.
SUPABASE_ACCESS_TOKEN=

# Stage 2: Resend test-mode key.
RESEND_API_KEY=

# Stage 3: the React app. Copy these two lines to .env.local (gitignored) and point them at STAGING.
# Only the publishable key belongs here: anything prefixed VITE_ is shipped to every browser.
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
