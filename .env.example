# Environment variables, by file. Copy each block to the named file (all gitignored) and fill it in.
# Never commit real values. Decision D1 (OPEN_QUESTIONS.md): there is no staging; everything points at
# the client's project.

# --- .env.production.local: scripts only (backups, the live RLS run, cleanup). Never in browser code.
PRODUCTION_PROJECT_REF=
PRODUCTION_SUPABASE_URL=https://<project-ref>.supabase.co
PRODUCTION_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key: creates confirmed rls-test accounts and removes them afterwards.
PRODUCTION_SUPABASE_SECRET_KEY=

# --- .env.local: the React app. Anything prefixed VITE_ is shipped to every browser, so only the
# publishable key belongs here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Shown to suppliers whose trial has ended (OPEN_QUESTIONS.md, item 12).
VITE_SUPPORT_EMAIL=support@caribbeantender.com
# Error reporting (OPEN_QUESTIONS.md, item 15). Leave empty to turn it off.
VITE_SENTRY_DSN=
