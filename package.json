{
  "name": "caribbeantender",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "node --test \"tests/app/**/*.test.ts\" \"tests/functions/**/*.test.ts\"",
    "test:database": "node --test --test-concurrency=1 \"tests/database/**/*.test.ts\"",
    "test:database:before-after": "node tests/database/before-after.ts",
    "types": "node scripts/generate-database-types.ts",
    "test:rls:local": "node scripts/run-rls.ts local",
    "test:browser:local": "playwright test --config tests/browser/playwright.config.ts",
    "test:e2e": "playwright test",
    "test:rls:live": "node --env-file=.env.production.local scripts/run-rls.ts live --after-state-only"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@sentry/react": "10.78.0",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.6"
  }
}
