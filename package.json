{
  "name": "caribbeantender",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "node --test \"tests/app/**/*.test.ts\" \"tests/functions/**/*.test.ts\"",
    "test:database": "node --test --test-concurrency=1 \"tests/database/**/*.test.ts\"",
    "test:database:before-after": "node tests/database/before-after.ts",
    "types": "node scripts/generate-database-types.ts",
    "test:rls:local": "node scripts/run-rls.ts local",
    "test:rls:live": "node --env-file=.env.production.local scripts/run-rls.ts live --after-state-only backups/2026-11-13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  }
}
